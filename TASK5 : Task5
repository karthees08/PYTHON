# 12. Library Fine Calculation


class Library:

    def get_fine(self):
        days = int(input("Enter number of late days: "))

        if days <= 5:
            fine = days * 0.40

        elif days <= 10:
            fine = (5 * 0.40) + ((days - 5) * 0.65)

        else:
            fine = (5 * 0.40) + (5 * 0.65) + ((days - 10) * 0.80)

        print("Fine: ₹", fine)


library = Library()
library.get_fine()


