# 9. Basic Calculator

a = float(input("Enter first number: "))
b = float(input("Enter second number: "))

operator = input("Enter operator (+, -, x, /): ")

if operator == "+":
    result = a + b
    print("Result:", result)

elif operator == "-":
    result = a - b
    print("Result:", result)

elif operator == "x":
    result = a * b
    print("Result:", result)

elif operator == "/":
    if b != 0:
        result = a / b
        print("Result:", result)
    else:
        print("Cannot divide by zero")

else:
    print("Invalid operator")


