    print(" " * (n - i) + "* " * i)
'''

#18. Hollow Pyramid Using *
'''
n = 5

for i in range(1, n + 1):
    print(" " * (n - i), end="")

    for j in range(1, 2 * i):
        if j == 1 or j == 2 * i - 1 or i == n:
            print("*", end="")
        else:
            print(" ", end="")

    print()
'''
