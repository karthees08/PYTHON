#3.Check if the number is divisible by both 2 and 5, and display the result.
'''
a=int(input("Enter the number:"))
if a%2==0 and a%5==0:
    print("The number is divisible by both 2 and 5")
    res1=a/2
    res2=a/5
    print("The result divided by 2 and 5 are:",res1,res2)
else:
    print("The number is not divisible by both 2 and 5")
'''
