#arithmetic operator

a=int(input("Enter a value for A:"))
b=int(input("Enter a value for B:"))

print(a+b)
print(a-b)
print(a*b)
print(a/b)
print(a//b)
print(a%b)
print(a**b)


#relational or conditional operator

a=int(input("Enter a value for A:"))
b=int(input("Enter a value for B:"))

print(a>b)
print(a<b)
print(a==b)
print(a!=b)
print(a>=b)
print(a<=b)



#logical operators

a=int(input("Enter a value for A:"))
b=int(input("Enter a value for B:"))

print(a > 0 and b > 0)
print(a > 0 or b > 0)
print(not(a > 0))
print(not(b > 0))


#bitwise operator

a=int(input("Enter a value for A:"))
b=int(input("Enter a value for B:"))



print(a & b)
print(a | b)
print(~a)
print(~b)
print(a^b)
